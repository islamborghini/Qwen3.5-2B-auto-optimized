import numpy as np

def sim_gemv(x, W, bn, bk, split, bm_override=None):
    M, K = x.shape; N, _ = W.shape
    bm = 1
    while bm < M: bm *= 2
    while bm * bn * bk > 8192 and bk > 64: bk //= 2
    k_per = K // split
    part = np.zeros((M, split, N), dtype=np.float32)
    for pid_n in range(-(-N // bn)):
        for pid_k in range(split):
            offs_m = np.arange(bm); offs_n = pid_n*bn + np.arange(bn); offs_k = np.arange(bk)
            mmask = offs_m < M; nmask = offs_n < N
            k_base = pid_k * k_per
            acc = np.zeros((bm, bn), np.float32)
            for k0 in range(0, k_per, bk):
                kk = k_base + k0 + offs_k
                kmask = (k0 + offs_k) < k_per
                # loads (guard OOB like Triton masked loads)
                w = np.zeros((bn, bk), np.float32)
                for i,n in enumerate(offs_n):
                    for j,k in enumerate(kk):
                        if nmask[i] and kmask[j]: w[i,j] = W[n,k]
                xx = np.zeros((bm, bk), np.float32)
                for i,m in enumerate(offs_m):
                    for j,k in enumerate(kk):
                        if mmask[i] and kmask[j]: xx[i,j] = x[m,k]
                prod = xx[:,None,:] * w[None,:,:]   # [bm,bn,bk]
                acc += prod.sum(axis=2)
            for i,m in enumerate(offs_m):
                for j,n in enumerate(offs_n):
                    if mmask[i] and nmask[j]:
                        part[m, pid_k, n] += acc[i,j]
    y = np.zeros((M,N), np.float32)
    for m in range(M):
        for n in range(N):
            y[m,n] = part[m,:,n].sum()
    return y.astype(np.float32)

rng = np.random.default_rng(0)
for (K,N) in [(37,13),(64,32),(128,9),(2048,32),(256,100),(512,64)]:
    for M in (1,2,3,4):
        x = rng.standard_normal((M,K)).astype(np.float32)
        W = rng.standard_normal((N,K)).astype(np.float32)
        ref = x @ W.T
        for split in (1,2,4):
            if K % split: continue
            got = sim_gemv(x,W,8,64,split)
            err = np.abs(got-ref).max()
            assert err < 1e-2, (K,N,M,split,err)
print("sim OK: pointer offsets + split-K reduction match x @ W.T")
